@model HospitalManagemenet.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-11 col-sm-8 col-md-6 col-lg-4">
        <div class="auth-card">
            <h2 class="text-center">Hospital Management System</h2>
            <h4 class="text-center mb-4">User Login</h4>

            <form asp-action="Login" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password" class="control-label"></label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" id="inputPassword" class="form-control" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('inputPassword', this)">👁</button>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="text-danger mt-3">
                    @ViewBag.ErrorMessage
                </div>
            }

            <p class="mt-3 text-center">
                Don't have an account? <a asp-controller="Auth" asp-action="Register">Register</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
}