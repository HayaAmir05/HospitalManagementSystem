@{
    ViewData["Title"] = "Dashboard";
}

 <h2 class="dashboard-title mt-4 mb-2">
    Welcome, @ViewBag.UserName
    <span class="badge bg-primary ms-2">@ViewBag.Role</span>
</h2>
<div class="dashboard-center ">
<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h4>Patients</h4>
            <p class="fs-3">@ViewBag.PatientCount</p>
            <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-primary">View All</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h4>Doctors</h4>
            <p class="fs-3">@ViewBag.DoctorCount</p>
            <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-primary">View All</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h4>Appointments</h4>
            <p class="fs-3">@ViewBag.AppointmentCount</p>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-primary">View All</a>
        </div>
    </div>
</div>

@if (ViewBag.Role == "Admin")
{
    <div class="mt-4">
        <h5>Admin Tools</h5>
        <a asp-controller="Doctors" asp-action="Create" class="btn btn-success me-2">➕ Add Doctor</a>
        <a asp-controller="Users" asp-action="Index" class="btn btn-secondary">⚙️ Manage Users</a>
    </div>
}
else if (ViewBag.Role == "Receptionist")
{

    <div class="mt-4">
        <h5>Front Desk</h5>
        <a asp-controller="Patients" asp-action="Create" class="btn btn-success me-2">➕ Register Patient</a>
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-success me-2">➕Create Appointment</a>
    </div> 
   
    
}
</div>