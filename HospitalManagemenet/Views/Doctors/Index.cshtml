@model IEnumerable<HospitalManagemenet.Models.Doctor>
@{
    ViewData["Title"] = "Doctors";
}

<h1>Doctors</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<div class="table-responsive">

<table class="table">
    <thead>
        <tr>
             <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Contact)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Specialization)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Experience)
            </th>
           
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Age)
            </td>
            <td>
                @Html.DisplayFor(model => item.Contact)
            </td>
            
            <td>
                @Html.DisplayFor(model => item.Specialization)
            </td>
           
            <td>
                @Html.DisplayFor(model => item.Experience)
            </td>
          
            
            <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-soft-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-soft-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-soft-danger">Delete</a>
                        </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-soft-primary">
        ← Back to Home Page
    </a>
</div>