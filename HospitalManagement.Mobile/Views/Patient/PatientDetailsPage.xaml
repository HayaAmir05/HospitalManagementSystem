<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="HospitalManagement.Mobile.Views.Patient.PatientDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FB"
    Title="Patient Details">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <!-- Header -->

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="12">

                <Button
                    Text="‹"
                    Clicked="Back_Clicked"
                    BackgroundColor="Transparent"
                    TextColor="#1F3A93"
                    FontSize="32"
                    WidthRequest="45"
                    HeightRequest="45"/>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="1">

                    <Label
                        Text="Patient Details"
                        FontSize="27"
                        FontAttributes="Bold"
                        TextColor="#1F2937"/>

                    <Label
                        Text="View patient information"
                        FontSize="13"
                        TextColor="#6B7280"/>

                </VerticalStackLayout>

            </Grid>


            <!-- Loading -->

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                Color="#1F3A93"
                HorizontalOptions="Center"/>


            <!-- Patient Card -->

            <Border
                x:Name="PatientCard"
                BackgroundColor="White"
                Padding="22"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22">

                <Border.Shadow>

                    <Shadow
                        Brush="#40000000"
                        Offset="2,3"
                        Radius="12"
                        Opacity="0.18"/>

                </Border.Shadow>

                <VerticalStackLayout
                    Spacing="18">

                    <!-- Avatar -->

                    <Frame
                        WidthRequest="80"
                        HeightRequest="80"
                        CornerRadius="40"
                        BackgroundColor="#E9F2FF"
                        Padding="0"
                        HasShadow="False"
                        HorizontalOptions="Center">

                        <Label
                            Text="🧑"
                            FontSize="42"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            TextColor="#111111"/>

                    </Frame>


                    <Label
                        x:Name="NameLabel"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#111111"
                        HorizontalOptions="Center"/>


                    <Label
                        x:Name="DiseaseLabel"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#1F4ACC"
                        HorizontalOptions="Center"/>


                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#E5E7EB"/>


                    <!-- Details -->

                    <Grid
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnDefinitions="120,*"
                        RowSpacing="15">

                        <Label
                            Text="Age"
                            TextColor="#6B7280"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="AgeLabel"
                            Grid.Column="1"
                            TextColor="#111111"
                            FontAttributes="Bold"/>


                        <Label
                            Grid.Row="1"
                            Text="Email"
                            TextColor="#6B7280"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="EmailLabel"
                            Grid.Row="1"
                            Grid.Column="1"
                            TextColor="#111111"
                            FontAttributes="Bold"/>


                        <Label
                            Grid.Row="2"
                            Text="Contact"
                            TextColor="#6B7280"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="ContactLabel"
                            Grid.Row="2"
                            Grid.Column="1"
                            TextColor="#111111"
                            FontAttributes="Bold"/>


                        <Label
                            Grid.Row="3"
                            Text="Address"
                            TextColor="#6B7280"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="AddressLabel"
                            Grid.Row="3"
                            Grid.Column="1"
                            TextColor="#111111"
                            FontAttributes="Bold"/>


                        <Label
                            Grid.Row="4"
                            Text="Created By"
                            TextColor="#6B7280"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="CreatedByLabel"
                            Grid.Row="4"
                            Grid.Column="1"
                            TextColor="#111111"
                            FontAttributes="Bold"/>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- Buttons -->

            <Button
                Text="✎  Edit Patient"
                Clicked="Edit_Clicked"
                BackgroundColor="#1F3A93"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="50"
                CornerRadius="15"/>

            <Button
                Text="Delete Patient"
                Clicked="Delete_Clicked"
                BackgroundColor="#B91C1C"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="50"
                CornerRadius="15"/>

            <Button
               Text="Back to Patients"
               Clicked="Back_Clicked"
                BackgroundColor="#E5E7EB"
             TextColor="#1F2937"
              FontSize="16"
              FontAttributes="Bold"
               HeightRequest="50"
               CornerRadius="15"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>