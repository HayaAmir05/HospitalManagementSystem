<?xml version="1.0" encoding="utf-8" ?>

<ContentPage x:Class="HospitalManagement.Mobile.Views.Patient.EditPatientPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="#F5F7FB" Title="Edit Patient">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header -->

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <Button Text="‹" Clicked="Back_Clicked" BackgroundColor="Transparent" TextColor="#1F3A93" FontSize="32" WidthRequest="45" HeightRequest="45"/>

                <VerticalStackLayout Grid.Column="1" Spacing="1">

                    <Label Text="Edit Patient" FontSize="28" FontAttributes="Bold" TextColor="#1F2937"/>

                    <Label Text="Update patient information" FontSize="14" TextColor="#6B7280"/>

                </VerticalStackLayout>

            </Grid>


            <!-- Loading while patient is being loaded -->

            <ActivityIndicator x:Name="PageLoadingIndicator" IsVisible="False" IsRunning="False" Color="#1F3A93" HorizontalOptions="Center"/>


            <!-- Main Card -->

            <Border BackgroundColor="White" Padding="20" StrokeThickness="0" StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Patient Information" FontSize="20" FontAttributes="Bold" TextColor="#111111"/>


                    <!-- Name -->

                    <Label Text="Name" FontAttributes="Bold" FontSize="14" TextColor="#111827"/>

                    <Border Stroke="#D9E1EC" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                        <Entry x:Name="NameEntry" Placeholder="Enter patient name" PlaceholderColor="#9CA3AF" TextColor="#111827" BackgroundColor="White" TextChanged="NameEntry_TextChanged" Unfocused="NameEntry_Unfocused"/>
                    </Border>

                    <Label x:Name="NameErrorLabel" TextColor="#DC2626" FontSize="13" FontAttributes="Bold" IsVisible="False"/>


                    <!-- Email -->

                    <Label Text="Email" FontAttributes="Bold" FontSize="14" TextColor="#111827"/>

                    <Border Stroke="#D9E1EC" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                        <Entry x:Name="EmailEntry" Placeholder="Enter patient email" PlaceholderColor="#9CA3AF" TextColor="#111827" BackgroundColor="White" Keyboard="Email" Unfocused="EmailEntry_Unfocused"/>
                    </Border>

                    <Label x:Name="EmailErrorLabel" TextColor="#DC2626" FontSize="13" FontAttributes="Bold" IsVisible="False"/>


                    <!-- Age -->

                    <Label Text="Age" FontAttributes="Bold" FontSize="14" TextColor="#111827"/>

                    <Border Stroke="#D9E1EC" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                        <Entry x:Name="AgeEntry" Placeholder="Enter age" PlaceholderColor="#9CA3AF" TextColor="#111827" BackgroundColor="White" Keyboard="Numeric" TextChanged="AgeEntry_TextChanged" Unfocused="AgeEntry_Unfocused"/>
                    </Border>

                    <Label x:Name="AgeErrorLabel" TextColor="#DC2626" FontSize="13" FontAttributes="Bold" IsVisible="False"/>


                    <!-- Contact -->

                    <Label Text="Contact" FontAttributes="Bold" FontSize="14" TextColor="#111827"/>

                    <Border Stroke="#D9E1EC" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                        <Entry x:Name="ContactEntry" Placeholder="03001234567" PlaceholderColor="#9CA3AF" TextColor="#111827" BackgroundColor="White" Keyboard="Telephone" TextChanged="ContactEntry_TextChanged" Unfocused="ContactEntry_Unfocused"/>
                    </Border>

                    <Label x:Name="ContactErrorLabel" TextColor="#DC2626" FontSize="13" FontAttributes="Bold" IsVisible="False"/>


                    <!-- Disease -->

                    <Label Text="Disease" FontAttributes="Bold" FontSize="14" TextColor="#111827"/>

                    <Border Stroke="#D9E1EC" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                        <Entry x:Name="DiseaseEntry" Placeholder="Enter disease" PlaceholderColor="#9CA3AF" TextColor="#111827" BackgroundColor="White" Unfocused="DiseaseEntry_Unfocused"/>
                    </Border>

                    <Label x:Name="DiseaseErrorLabel" TextColor="#DC2626" FontSize="13" FontAttributes="Bold" IsVisible="False"/>


                    <!-- Address -->

                    <Label Text="Address" FontAttributes="Bold" FontSize="14" TextColor="#111827"/>

                    <Border Stroke="#D9E1EC" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                        <Editor x:Name="AddressEditor" Placeholder="Enter patient address" PlaceholderColor="#9CA3AF" TextColor="#111827" BackgroundColor="White" AutoSize="TextChanges" MinimumHeightRequest="100" Unfocused="AddressEditor_Unfocused"/>
                    </Border>

                    <Label x:Name="AddressErrorLabel" TextColor="#DC2626" FontSize="13" FontAttributes="Bold" IsVisible="False"/>


                    <!-- General API/System Error -->

                    <Label x:Name="GeneralErrorLabel" TextColor="#DC2626" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="False"/>


                    <!-- Saving -->

                    <ActivityIndicator x:Name="SavingIndicator" IsVisible="False" IsRunning="False" Color="#1F3A93" HorizontalOptions="Center"/>


                    <!-- Save -->

                    <Button Text="Save Changes" Clicked="Save_Clicked" BackgroundColor="#1F3A93" TextColor="White" FontAttributes="Bold" FontSize="16" HeightRequest="52" CornerRadius="15"/>


                    <!-- Cancel -->

                    <Button Text="Cancel" Clicked="Back_Clicked" BackgroundColor="#E5E7EB" TextColor="#1F2937" FontAttributes="Bold" HeightRequest="48" CornerRadius="15"/>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>