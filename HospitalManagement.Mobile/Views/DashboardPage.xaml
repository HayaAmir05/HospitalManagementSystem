<?xml version="1.0" encoding="utf-8" ?>

<ContentPage x:Class="HospitalManagement.Mobile.DashboardPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="#F4F6FA" Title="Dashboard" Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- HERO / WELCOME CARD -->

            <Border BackgroundColor="#1F3A93" StrokeThickness="0" StrokeShape="RoundRectangle 26" Padding="24">

                <Border.Shadow>
                    <Shadow Brush="#33000000" Offset="0,5" Radius="14" Opacity="0.25"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="6">

                        <Label Text="Hospital Management" FontSize="13" FontAttributes="Bold" TextColor="#C9D8FF"/>

                        <Label Text="Welcome back," FontSize="15" TextColor="#E5ECFF"/>

                        <Label x:Name="UserNameLabel" Text="User" FontSize="30" FontAttributes="Bold" TextColor="White"/>

                    </VerticalStackLayout>

                    <Border Grid.Column="1" BackgroundColor="#FFFFFF22" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,7" VerticalOptions="Start">

                        <Label x:Name="UserRoleLabel" Text="Role" FontSize="12" FontAttributes="Bold" TextColor="White"/>

                    </Border>

                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="Manage doctors, patients and appointments from one place." FontSize="13" TextColor="#DCE5FF" Margin="0,18,0,0"/>

                </Grid>

            </Border>


            <!-- SECTION TITLE -->

            <VerticalStackLayout Spacing="2">

                <Label Text="Quick Access" FontSize="22" FontAttributes="Bold" TextColor="#1F2937"/>

                <Label Text="Choose what you want to manage." FontSize="14" TextColor="#6B7280"/>

            </VerticalStackLayout>


            <!-- DOCTORS -->

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18">

                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,3" Radius="10" Opacity="0.20"/>
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDoctorsTapped"/>
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="14">

                    <Border BackgroundColor="#E8F0FF" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="58" HeightRequest="58" VerticalOptions="Center">

                        <Label Text="👨‍⚕️" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black"/>

                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                        <Label Text="Doctors" FontSize="19" FontAttributes="Bold" TextColor="#111827"/>

                        <Label Text="View and manage hospital doctors." FontSize="13" TextColor="#6B7280"/>

                    </VerticalStackLayout>

                    <Label Grid.Column="2" Text="❯" FontSize="22" FontAttributes="Bold" TextColor="#1F3A93" VerticalOptions="Center"/>

                </Grid>

            </Border>


            <!-- PATIENTS -->

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18">

                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,3" Radius="10" Opacity="0.20"/>
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPatientsTapped"/>
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="14">

                    <Border BackgroundColor="#E8F7F0" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="58" HeightRequest="58" VerticalOptions="Center">

                        <Label Text="🧑‍🤝‍🧑" FontSize="27" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black"/>

                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                        <Label Text="Patients" FontSize="19" FontAttributes="Bold" TextColor="#111827"/>

                        <Label Text="View and manage patient records." FontSize="13" TextColor="#6B7280"/>

                    </VerticalStackLayout>

                    <Label Grid.Column="2" Text="❯" FontSize="22" FontAttributes="Bold" TextColor="#1F3A93" VerticalOptions="Center"/>

                </Grid>

            </Border>


            <!-- APPOINTMENTS -->

            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="18">

                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,3" Radius="10" Opacity="0.20"/>
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAppointmentsTapped"/>
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="14">

                    <Border BackgroundColor="#FFF4DD" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="58" HeightRequest="58" VerticalOptions="Center">

                        <Label Text="📅" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black"/>

                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                        <Label Text="Appointments" FontSize="19" FontAttributes="Bold" TextColor="#111827"/>

                        <Label Text="Schedule and manage appointments." FontSize="13" TextColor="#6B7280"/>

                    </VerticalStackLayout>

                    <Label Grid.Column="2" Text="❯" FontSize="22" FontAttributes="Bold" TextColor="#1F3A93" VerticalOptions="Center"/>

                </Grid>

            </Border>


            <!-- LOGOUT -->

            <Border BackgroundColor="#FFF5F5" Stroke="#FECACA" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="4" Margin="0,8,0,0">

                <Button Text="Logout" Clicked="OnLogoutClicked" BackgroundColor="Transparent" TextColor="#DC2626" FontAttributes="Bold" FontSize="15" HeightRequest="48"/>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>