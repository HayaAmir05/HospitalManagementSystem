<ContentPage
    x:Class="HospitalManagement.Mobile.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F7FC">

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="18"
                MaximumWidthRequest="380">

                <Label Text="🏥" FontSize="50" HorizontalOptions="Center"/>
                <Label Text="Hospital Management" FontSize="28" FontAttributes="Bold"
                       TextColor="#1F3A93" HorizontalOptions="Center"/>
                <Label Text="Welcome Back" FontSize="16" TextColor="Gray" HorizontalOptions="Center"/>


                <Label Text="Hospital Email" FontAttributes="Bold" FontSize="14" TextColor="Black"/> 
                
                <Border Stroke="#D9D9D9" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <Entry x:Name="EmailEntry" Placeholder="Enter the Email" TextColor="Black" Keyboard="Email" Margin="10"/>
                </Border>

                <Label x:Name="EmailErrorLabel" TextColor="Red" FontSize="12" IsVisible="False"/>



                <Label Text="Password" FontAttributes="Bold" FontSize="14" TextColor="Black"/>
                <Border Stroke="#D9D9D9" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                  
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="PasswordEntry" Grid.Column="0"
                               Placeholder="Enter the Password" TextColor="Black" IsPassword="True" Margin="10"/>
                        <Button x:Name="ToggleButton" Grid.Column="1"
                                Text="👁" BackgroundColor="Transparent" TextColor="Gray"
                                Clicked="OnTogglePasswordClicked" WidthRequest="45"/>
                    </Grid>
                </Border>

                
                <Label x:Name="PasswordErrorLabel" TextColor="Red" FontSize="12"  IsVisible="False"/>

                <Label x:Name="GeneralErrorLabel" TextColor="Red" FontSize="13" HorizontalOptions="Center" IsVisible="False"/>
                
                <Button Text="Login" HeightRequest="50" CornerRadius="10"
                        BackgroundColor="#1F3A93" TextColor="White"
                        Clicked="OnLoginClicked"/>

                <Label Text="Don't have an account? Register"
                       TextColor="#1F3A93" HorizontalOptions="Center"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>