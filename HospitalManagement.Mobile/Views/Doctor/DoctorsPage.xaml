<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HospitalManagement.Mobile.DoctorsPage"
    Title="Doctors"
    BackgroundColor="#F4F6FA"
    Shell.NavBarIsVisible="True">

    <Grid>

        <RefreshView
            x:Name="RefreshDoctors"
            Refreshing="RefreshDoctors_Refreshing">

            <ScrollView>

                <VerticalStackLayout
                    Padding="20"
                    Spacing="20">

                    <!-- Header -->

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="2">

                            <Label
                                Text="Doctors"
                                FontSize="34"
                                FontAttributes="Bold"
                                TextColor="#1F2937"/>

                            <Label
                                Text="Manage hospital doctors"
                                FontSize="15"
                                TextColor="#6B7280"/>

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="+ Add Doctor"
                            Clicked="AddDoctor_Clicked"
                            BackgroundColor="#1F3A93"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            WidthRequest="155"
                            HeightRequest="46"
                            CornerRadius="15"/>

                    </Grid>

                    <!-- Search -->

                    <SearchBar
                        x:Name="SearchBarDoctors"
                        Placeholder="Search doctor by name or specialization..."
                        PlaceholderColor="#888888"
                        TextColor="Black"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="White"
                        TextChanged="SearchBarDoctors_TextChanged"/>

                    <!-- Loading -->

                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        HorizontalOptions="Center"
                        Color="#1F3A93"/>

                    <!-- Empty -->

                    <VerticalStackLayout
                        x:Name="EmptyLayout"
                        IsVisible="False"
                        HorizontalOptions="Center"
                        Padding="40"
                        Spacing="10">

                        <Label
                            Text="👨‍⚕️"
                            FontSize="70"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="No Doctors Found"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="Black"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Tap Add Doctor to create your first doctor."
                            HorizontalTextAlignment="Center"
                            TextColor="#666666"/>

                    </VerticalStackLayout>

                    <!-- Doctors -->

                    <CollectionView
                        x:Name="DoctorsCollectionView"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="0,6"
                                    Padding="16"
                                    BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">

                                    <Border.Shadow>
                                        <Shadow
                                            Brush="#22000000"
                                            Offset="0,3"
                                            Radius="10"
                                            Opacity="0.25"/>
                                    </Border.Shadow>

                                    <Border.GestureRecognizers>

                                        <TapGestureRecognizer
                                            Tapped="DoctorCard_Tapped"/>

                                    </Border.GestureRecognizers>

                                    <Grid
                                        ColumnDefinitions="70,*,25"
                                        RowDefinitions="Auto,Auto,Auto,Auto">

                                        <!-- Avatar -->

                                        <Frame
                                            WidthRequest="56"
                                            HeightRequest="56"
                                            CornerRadius="28"
                                            BackgroundColor="#E8F0FF"
                                            Padding="0"
                                            HasShadow="False">

                                            <Label
                                                Text="👨‍⚕️"
                                                FontSize="30"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                TextColor="Black"/>

                                        </Frame>

                                        <!-- Name -->

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            FontSize="20"
                                            FontAttributes="Bold"
                                            TextColor="Black"/>

                                        <!-- Specialization -->

                                        <Label
                                            Grid.Column="1"
                                            Grid.Row="1"
                                            Text="{Binding Specialization}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#1F3A93"/>

                                        <!-- Contact -->

                                        <Label
                                            Grid.Column="1"
                                            Grid.Row="2"
                                            FontSize="13"
                                            TextColor="#555555">

                                            <Label.FormattedText>

                                                <FormattedString>

                                                    <Span Text="📞 "/>

                                                    <Span Text="{Binding Contact}"/>

                                                </FormattedString>

                                            </Label.FormattedText>

                                        </Label>

                                        <!-- Age Experience -->

                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            Grid.Row="3"
                                            Spacing="20">

                                            <Label TextColor="#555555">

                                                <Label.FormattedText>

                                                    <FormattedString>

                                                        <Span Text="Age: "/>

                                                        <Span
                                                            Text="{Binding Age}"
                                                            FontAttributes="Bold"
                                                            TextColor="Black"/>

                                                    </FormattedString>

                                                </Label.FormattedText>

                                            </Label>

                                            <Label TextColor="#555555">

                                                <Label.FormattedText>

                                                    <FormattedString>

                                                        <Span Text="Experience: "/>

                                                        <Span
                                                            Text="{Binding Experience}"
                                                            FontAttributes="Bold"
                                                            TextColor="Black"/>

                                                        <Span Text=" yrs"/>

                                                    </FormattedString>

                                                </Label.FormattedText>

                                            </Label>

                                        </HorizontalStackLayout>

                                        <!-- Arrow -->

                                        <Label
                                            Grid.Column="2"
                                            Grid.RowSpan="4"
                                            Text="❯"
                                            FontSize="24"
                                            FontAttributes="Bold"
                                            TextColor="#1F3A93"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>